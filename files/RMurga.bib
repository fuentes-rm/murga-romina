@article{murga_feasibility_2026,
	author = {Murga, Romina and Uribe, Lina and Carmona Franco, Manuel and Gutiérrez, Leopoldo and Giraldo, Juan D.},
	title = {Feasibility of using guar gum as a pyrite depressant in chalcopyrite flotation with seawater},
	journal = {Results in Engineering},
	volume = {32},
	pages = {113996},
	year = {2026},
	month = {nov},
	doi = {10.1016/j.rineng.2026.113996},
	url = {https://doi.org/10.1016/j.rineng.2026.113996},
	abstract = {Guar gum (GG) was evaluated as a depressant of pyrite and chalcopyrite in the presence of potassium amyl xanthate (PAX) as collector and methyl isobutyl carbinol (MIBC) as a frothing agent. The interaction of this biopolymer with these minerals was monitored in two aqueous systems, seawater (SW) and continental water (CW), through contact angle, zeta potential, ATR-FTIR spectroscopy, and UV-Visible spectroscopy. The ATR-FTIR spectra revealed a characteristic O-H stretching vibration band at around 3500-3000 cm-1, indicating an interaction between the GG and the minerals. Zeta potential measurements confirmed that GG possesses an anionic nature (-4.71 ± 1.24 mV), which enables electrostatic interaction with the mineral surface and the change in the potential of this surface toward more positive values. Contact angle results showed that the addition of GG exacerbates pyrite's hydrophilic character if it is added after the addition of PAX, whereas this is not the case with chalcopyrite, allowing for its flotation. UV-Visible spectra demonstrated that GG reduced PAX adsorption onto pyrite, particularly in SW, where GG formed coordinated complexes with dissolved ions from both minerals. The results demonstrated that seawater exerts a baseline depressant effect on the pyrite surface, with the inclusion of guar gum providing an additional 21 percentage points of enhanced pyrite depression.}
}

@article{rodriguez_influence_2026,
	author = {Rodríguez, Camila and Murga, Romina and Gutiérrez, Leopoldo and Uribe, Lina},
	title = {Influence of cationic nanocrystals on the flotation recovery of molybdenum, copper, and iron sulfides},
	journal = {Minerals Engineering},
	volume = {249},
	pages = {110706},
	year = {2026},
	month = {jul},
	doi = {10.1016/j.mineng.2026.110706},
	url = {https://doi.org/10.1016/j.mineng.2026.110706},
	abstract = {This study investigates the influence of functionalized cationic nanocrystals on the selective flotation recovery and surface interactions of molybdenum, copper, and iron sulfide minerals (molybdenite, chalcopyrite, and pyrite), evaluating their potential as sustainable nanoreagents in sulfide mineral processing circuits.}
}

@article{estrada_styrene_2024,
	author = {Estrada, Darwin and Murga, Romina and Rubilar, Olga and Amalraj, John and Gutiérrez, Leopoldo and Uribe, Lina},
	title = {On the Use of Styrene-Based Nanoparticles to Mitigate the Effect of Montmorillonite in Copper Sulfide Recovery by Flotation},
	journal = {Polymers},
	volume = {16},
	number = {12},
	pages = {1682},
	year = {2024},
	month = {jun},
	doi = {10.3390/polym16121682},
	url = {https://doi.org/10.3390/polym16121682},
	abstract = {Clay minerals have different negative effects on the froth flotation process such as low adsorption of collectors on valuable minerals, increased pulp viscosity, and the reduction in recovery and grade concentrates of copper sulfides. This study aims to evaluate the use of polystyrene-based nanoparticles (NPs) for the froth flotation of chalcopyrite and their ability to mitigate the negative effect of montmorillonite on the recovery of this sulfide. The experimental stage consisted of preparing a type of polystyrene-based nanoparticle (St-CTAB-VI), which was analyzed by dynamic light scattering (DLS) to establish its hydrodynamic size. Then, the effect of NPs on chalcopyrite's contact angle in the presence and absence of montmorillonite (15%) was evaluated and compared with the contact angle achieved using potassium amyl xanthate (PAX) and a mixture of PAX and NPs. In addition, zeta potential measurements were carried out to investigate the interactions between the chalcopyrite and the montmorillonite or the NPs under fixed concentrations and microflotation tests were performed employing different times to evaluate the chalcopyrite recovery in the presence of montmorillonite, using NPs and mixtures with PAX. Finally, turbidity analysis as a function of time was performed to evaluate the occurrence of sedimentation and flocculation phenomena in suspensions of 15% montmorillonite. The results indicated that the mixture of NPs and PAX contributed to increasing the contact angle of chalcopyrite in the presence of montmorillonite, detaching clay slimes and facilitating bubble-mineral attachment during flotation.}
}

@article{murga_polystyrene_2022,
	author = {Murga, Romina and Rodríguez, Camila and Amalraj, John and Vega-Garcia, Dennis and Gutiérrez, Leopoldo and Uribe, Lina},
	title = {Use of Polystyrene Nanoparticles as Collectors in the Flotation of Chalcopyrite},
	journal = {Polymers},
	volume = {14},
	number = {23},
	pages = {5259},
	year = {2022},
	month = {dec},
	doi = {10.3390/polym14235259},
	url = {https://doi.org/10.3390/polym14235259},
	abstract = {This study proposes the use of polymeric nanoparticles (NPs) as collectors for copper sulfide flotation. The experimental phase included the preparation of two types of polystyrene-based NPs: St-CTAB and St-CTAB-VI. These NPs were characterized by Fourier-Transform Infrared (FTIR) spectroscopy and dynamic light scattering (DLS). Then, microflotation tests with chalcopyrite under different pH conditions and nanoparticle dosages were carried out to verify their capabilities as chalcopyrite collectors. In addition, zeta potential (ZP) measurements of chalcopyrite in the presence and absence of NPs were carried out to study their interaction. Lastly, Atomic Force Micrographs (AFM) of NPs and Scanning Electron Microscopy (SEM) and Energy Dispersive X-ray Spectroscopy (EDS) analysis of NPs on the chalcopyrite surface were conducted to analyze the size, morphology, and interaction. The results obtained at pH 6 and pH 8 show that the NPs under study can achieve a chalcopyrite recovery near or higher than that obtained with the conventional collector, with NPs functionalized by the imidazole group (St-CTAB-VI) achieving superior affinity with the mineral surface.}
}

@article{quiroz_lignosulfonates_2022,
	author = {Quiroz, Consuelo and Murga, Romina and Giraldo, Juan David and Gutiérrez, Leopoldo and Uribe, Lina},
	title = {Understanding the Interaction of Lignosulfonates for the Separation of Molybdenite and Chalcopyrite in Seawater Flotation Processes},
	journal = {Polymers},
	volume = {14},
	number = {14},
	pages = {2834},
	year = {2022},
	month = {jul},
	doi = {10.3390/polym14142834},
	url = {https://doi.org/10.3390/polym14142834},
	abstract = {The selective separation of molybdenite from copper sulfide concentrate in flotation processes is commonly carried out using sodium hydrosulfide (NaHS) to depress chalcopyrite and permit only the flotation of molybdenite. However, this reagent generates toxic and flammable gas. The objective of this research was to study the feasible application of commercial lignosulfonates (LSs) in the separation by froth flotation of molybdenite and chalcopyrite in seawater as an environmentally friendlier alternative reagent to NaHS. Microflotation, absorbance tests, and zeta potential measurements were performed at pH 8 in seawater and 0.01 M NaCl. The results showed that selective separation of copper and molybdenum is achieved in both aqueous media due to the strong depressant effect on molybdenite and low depression of chalcopyrite at 10 ppm of LSs when the collector (PAX) is added prior to LSs. Absorbance and zeta potential measurements confirmed greater LS adsorption onto molybdenite in seawater due to the high ionic strength of the medium.}
}

